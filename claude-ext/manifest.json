{
  "manifest_version": 3,
  "name": "OpenClaude Desktop Bridge",
  "description": "Lets OpenClaude Desktop read and operate the pages you open in Chrome.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
