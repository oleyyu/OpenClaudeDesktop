{
  "format": 1,
  "version": "0.162.1",
  "description": "OpenAI Codex for OpenClaude Desktop: the official open-source Codex CLI, whose app-server speaks OpenClaude Desktop's protocol itself.",
  "core": {
    "id": "codex",
    "assistant": "Codex",
    "brand": "codex",
    "tagline": "OpenAI’s coding agent. Sign in with your ChatGPT account or an OpenAI key.",
    "name": "Codex",
    "vendor": "OpenAI",
    "engine": "codex",
    "kind": "native",
    "models": "OpenAI models, signed in with ChatGPT or an OpenAI API key",
    "homepage": "https://github.com/openai/codex",
    "license": "Apache-2.0",
    "implies": {
      "nativeTools": ["AskUserQuestion"],
