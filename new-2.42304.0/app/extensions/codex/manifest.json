      "collaborationModes": true,
      "structuredOutput": true,
      "sideQuestion": true,
      "fileMentions": false,
      "sandboxNetwork": "policy",
      "shellCommands": true,
      "hooksList": true,
      "appsDirectory": true,
      "threadSearch": true,
      "titleRequest": true,
      "agentsList": true
    },
    "login": {
      "browser": [{ "type": "chatgpt", "label": "Continue with ChatGPT" }],
